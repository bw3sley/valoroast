# OpenAI key used by the `ai` SDK (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# HenrikDev unofficial Valorant API key, free "Basic" tier = 30 req/min
# Generate one at https://api.henrikdev.xyz/dashboard/
HENRIKDEV_API_KEY=

# Neon Postgres connection string (https://console.neon.tech), include ?sslmode=require
DATABASE_URL=
